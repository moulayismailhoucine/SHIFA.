# ─────────────────────────────────────────
# App
# ─────────────────────────────────────────
APP_SECRET_KEY=CHANGE_ME_STRONG_RANDOM_SECRET_32CHARS
APP_DEBUG=false
APP_URL=http://localhost:8000

# ─────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────
DATABASE_URL=postgresql://medisys:medisys_pass@localhost:5432/medisys_db

# ─────────────────────────────────────────
# JWT
# ─────────────────────────────────────────
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ─────────────────────────────────────────
# File Storage
# ─────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ─────────────────────────────────────────
# AI Provider (Google Gemini)
# ─────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─────────────────────────────────────────
# Edge / Cloudflare Worker
# ─────────────────────────────────────────
BACKEND_ORIGIN=http://localhost:8000

# ─────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────
RATE_LIMIT_BOOKING=5/minute
RATE_LIMIT_CONTACT=5/minute
